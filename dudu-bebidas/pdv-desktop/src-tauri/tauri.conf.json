{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDV Dudu Bebidas",
  "version": "0.2.12",
  "identifier": "com.dudubebidas.pdv",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FDigital — Dudu Bebidas",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --kiosk-printing"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVBODk0QjUxRTA4QzEzMjMKUldRakU0emdVVXVKNnVMTXZ1RElpZmVUanRoaXBUK09UUjE5Qlc2QUVNTURWOHE0azJ2c1d0MVIK",
      "endpoints": [
        "https://ixjhyzzocdsufcqgbbvf.supabase.co/storage/v1/object/public/pdv-releases/latest.json"
      ]
    }
  }
}
